  "scripts": {
    "reset": "git checkout -- . && git clean -fd",
    "clean": "rm -rf node_modules package-lock.json yarn.lock artifacts cache",
    "sampoia": "hardhat run --network sampoia scripts/00-Deploy.js",
    "local": "hardhat run --network localhost scripts/00-Deploy.js",
    "add": "hardhat run --network localhost scripts/01-AddCandidates.js",
    "time": "hardhat run --network localhost scripts/02-GetRemaningTime.js",
    "status": "hardhat run --network localhost scripts/03-GetVotingStatus.js",
    "candidates": "hardhat run --network localhost scripts/04-GetAllCandidates.js",
    "vote": "hardhat run --network localhost scripts/05-Vote.js",
    "votes": "hardhat run --network localhost scripts/06-GetAllVotes.js",
    "start": "hardhat run --network localhost scripts/07-StartVotingProcess.js",
    "remove": "hardhat run --network localhost scripts/08-RemoveCandidate.js",
    "end": "hardhat run --network localhost scripts/09-EndVotingProcess.js",
    "indices": "hardhat run --network localhost scripts/10-GetCandidatesWithIndices.js"
