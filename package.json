{
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "chai": "^4.2.0",
    "dotenv": "^16.4.5",
    "ethers": "5.7.0",
    "hardhat": "^2.22.15",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-covwerage": "^0.8.0",
    "typechain": "^8.3.0"
  },
  "scripts": {
    "reset": "git checkout -- . && git clean -fd",
    "clean": "rm -rf node_modules package-lock.json yarn.lock artifacts cache",

    "local:deploy": "hardhat run --network localhost scripts/00-Deploy.js",
    "sampoia:deploy": "hardhat run --network sampoia scripts/00-Deploy.js",

    "local:add": "hardhat run --network localhost scripts/01-AddCandidates.js",
    "local:time": "hardhat run --network localhost scripts/02-GetRemaningTime.js",
    "local:status": "hardhat run --network localhost scripts/03-GetVotingStatus.js",
    "local:candidates": "hardhat run --network localhost scripts/04-GetAllCandidates.js",
    "local:vote": "hardhat run --network localhost scripts/05-Vote.js",
    "local:votes": "hardhat run --network localhost scripts/06-GetAllVotes.js",
    "local:start": "hardhat run --network localhost scripts/07-StartVotingProcess.js",
    "local:remove": "hardhat run --network localhost scripts/08-RemoveCandidate.js",
    "local:end": "hardhat run --network localhost scripts/09-EndVotingProcess.js",
    "local:indices": "hardhat run --network localhost scripts/10-GetCandidatesWithIndices.js",

    "sampoia:add": "hardhat run --network sampoia scripts/01-AddCandidates.js",
    "sampoia:time": "hardhat run --network sampoia scripts/02-GetRemaningTime.js",
    "sampoia:status": "hardhat run --network sampoia scripts/03-GetVotingStatus.js",
    "sampoia:candidates": "hardhat run --network sampoia scripts/04-GetAllCandidates.js",
    "sampoia:vote": "hardhat run --network sampoia scripts/05-Vote.js",
    "sampoia:votes": "hardhat run --network sampoia scripts/06-GetAllVotes.js",
    "sampoia:start": "hardhat run --network sampoia scripts/07-StartVotingProcess.js",
    "sampoia:remove": "hardhat run --network sampoia scripts/08-RemoveCandidate.js",
    "sampoia:end": "hardhat run --network sampoia scripts/09-EndVotingProcess.js",
    "sampoia:indices": "hardhat run --network sampoia scripts/10-GetCandidatesWithIndices.js"
  },
  "license": "MIT"
}
